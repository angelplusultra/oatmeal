{
  "name": "oatmeal",
  "productName": "Oatmeal",
  "version": "0.1.1-beta.8",
  "description": "Private, local meeting notes: detects calls, transcribes them on-device, and writes notes with a local LLM.",
  "author": {
    "name": "Marcello Fitton",
    "email": "macfittondev@gmail.com"
  },
  "homepage": "https://github.com/angelplusultra/oatmeal",
  "desktopName": "oatmeal.desktop",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run setup && electron-vite dev",
    "build": "npm run setup && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac:local": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --config electron-builder.yml -c.mac.identity=-",
    "dist:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
    "dist:linux:dir": "npm run build && electron-builder --linux dir --config electron-builder.yml",
    "make-test-meeting": "node scripts/make-test-meeting.mjs",
    "make-icons": "electron scripts/make-icons.mjs",
    "postversion": "git push --follow-tags",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.7",
    "node-llama-cpp": "^3.22.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "koffi@3.3.7": true,
    "node-llama-cpp@3.22.3": true,
    "electron-winstaller": false,
    "fsevents": false
  }
}
