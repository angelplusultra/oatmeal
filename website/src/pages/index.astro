---
import { Image } from 'astro:assets'
import icon from '../../../assets/icon.svg'
import callPanel from '../../../docs/screenshots/call-panel.png'
import notes from '../../../docs/screenshots/notes.png'
import notesReady from '../../../docs/screenshots/notes-ready.png'
import latte from '../../../docs/screenshots/omarchy-catppuccin-latte.png'
import matteBlack from '../../../docs/screenshots/omarchy-matte-black.png'
import rosePine from '../../../docs/screenshots/omarchy-rose-pine.png'
import tokyoNight from '../../../docs/screenshots/omarchy-tokyo-night.png'
import transcript from '../../../docs/screenshots/transcript.png'
import Base from '../layouts/Base.astro'
import { repoUrl as repo } from '../lib/release'

const download = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/download/`
const apps = ['Zoom', 'Google Meet', 'Microsoft Teams', 'Slack', 'Discord', 'FaceTime', 'Webex', 'WhatsApp']
const themes = [
  [matteBlack, 'Matte Black'],
  [tokyoNight, 'Tokyo Night'],
  [rosePine, 'Rosé Pine'],
  [latte, 'Catppuccin Latte'],
] as const
---

<Base
  title="Oatmeal: private meeting notes"
  description="Oatmeal transcribes your calls and writes meeting notes entirely on your computer. Audio is never saved, and nothing is uploaded."
>

    <header class="hero" id="top">
      <div class="glow" aria-hidden="true"></div>
      <a class="badge" href={download}><span class="dot"></span> Free, open source, now in beta <span>→</span></a>
      <h1>Meeting notes that <em>never leave</em> your computer.</h1>
      <p class="lede">
        Oatmeal notices when a call starts, transcribes it on-device, and writes the notes when it ends. No bots in your
        meetings. No cloud. No account.
      </p>
      <div class="actions">
        <a class="btn btn-honey" href={download}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M5 21h14"></path></svg>
          Download Oatmeal
        </a>
        <a class="btn btn-ghost" href={repo}>
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M12 2l3 6.5 7 .8-5.2 4.8 1.5 7L12 17.5 5.7 21l1.5-7L2 9.3l7-.8z"></path></svg
          >
          Star on GitHub
        </a>
      </div>
      <p class="platforms">macOS 15+ on Apple Silicon · Linux x64 with PipeWire</p>

      <div class="stage">
        <div class="window">
          <div class="window-bar"><i></i><i></i><i></i></div>
          <Image
            src={notes}
            widths={[960, 1600, 2240]}
            sizes="(max-width: 1100px) 100vw, 1100px"
            alt="Oatmeal's notes view: a summary, action items with owners and timestamps, decisions and key points"
            loading="eager"
          />
        </div>
        <Image class="float float-left" src={callPanel} alt="Zoom is using your microphone. Transcribe this call?" />
        <Image class="float float-right" src={notesReady} alt="Your notes are ready, with View notes and Dismiss" />
      </div>
    </header>

    <section class="marquee" aria-label="Works with">
      <p>Works with the apps you already call from</p>
      <div class="track">
        {[0, 1].map((copy) => (
          <ul aria-hidden={copy === 1 ? 'true' : undefined}>
            {apps.map((app) => <li>{app}</li>)}
          </ul>
        ))}
      </div>
    </section>

    <section class="section" id="how">
      <p class="eyebrow">How it works</p>
      <h2 class="reveal">Join the call. <em>That's it.</em></h2>
      <ol class="steps">
        <li class="reveal">
          <span class="step-num">01</span>
          <h3>A call starts</h3>
          <p>When Zoom, Meet or Teams takes the mic, a small panel asks once. Say yes, or never for that app.</p>
        </li>
        <li class="reveal">
          <span class="step-num">02</span>
          <h3>It listens, locally</h3>
          <div class="wave" aria-hidden="true">
            {Array.from({ length: 28 }, (_, i) => <span style={`--i:${i}`}></span>)}
          </div>
          <p>Moonshine transcribes your mic and the call's audio on your machine. Audio is never written to disk.</p>
        </li>
        <li class="reveal">
          <span class="step-num">03</span>
          <h3>Notes when it ends</h3>
          <p>Hang up and a local Gemma model writes the summary, decisions and action items. Nothing pops open.</p>
        </li>
      </ol>
    </section>

    <section class="section" id="features">
      <p class="eyebrow">Features</p>
      <h2 class="reveal">Notes worth <em>reading</em>.</h2>
      <div class="bento">
        <article class="card span-4 reveal">
          <h3>Every speaker, separated</h3>
          <p>Your mic is "You". Everyone else is split into speakers you can rename, and the notes use the new names.</p>
          <div class="crop">
            <Image src={transcript} widths={[900, 1600]} sizes="(max-width: 900px) 100vw, 700px" alt="A transcript with You, Priya and Marcus in different colors" />
          </div>
        </article>

        <article class="card span-2 reveal">
          <h3>Action items that point back</h3>
          <p>Owners, due dates and a timestamp linking to the moment it was said.</p>
          <ul class="mock-items">
            <li><span class="check on"></span><s>Own the migration plan</s><b class="chip">Marcus</b><code>00:48</code></li>
            <li><span class="check"></span>Ask finance about budget<b class="chip">Priya</b><code>01:12</code></li>
            <li><span class="check"></span>Draft the job description<b class="chip">Marcus</b><code>01:18</code></li>
          </ul>
        </article>

        <article class="card span-2 reveal">
          <h3>Bring your own model</h3>
          <p>Gemma 4 built in, any GGUF on disk, or an OpenAI-compatible server you run.</p>
          <ul class="chips">
            <li>Gemma 4 E2B</li>
            <li class="on">Gemma 4 E4B</li>
            <li>Gemma 4 26B A4B</li>
            <li>LM Studio</li>
            <li>Ollama</li>
            <li>llama-server</li>
          </ul>
        </article>

        <article class="card span-3 reveal">
          <h3>Search every meeting</h3>
          <p>Full-text search across every transcript, stored in a local SQLite file.</p>
          <div class="mock-search">
            <div class="mock-input">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
              grandfather
            </div>
            <p>"What if we <mark>grandfather</mark> existing enterprise customers…"</p>
          </div>
        </article>

        <article class="card span-3 reveal">
          <h3>Yours to keep</h3>
          <p>Export transcripts as .txt, .md or .json. Copy notes as Markdown.</p>
          <div class="files" aria-hidden="true">
            <span>.md</span><span>.txt</span><span>.json</span>
          </div>
        </article>

        <article class="card span-6 themes-card reveal">
          <div>
            <h3>Dressed by your desktop</h3>
            <p>On Omarchy, Oatmeal takes its colors and corner rounding from your theme, and follows every <code>omarchy theme set</code> live.</p>
          </div>
          <div class="fan">
            {themes.map(([src, name], i) => (
              <Image src={src} widths={[640, 1262]} sizes="420px" alt={`Oatmeal in the ${name} theme`} style={`--i:${i}`} />
            ))}
          </div>
        </article>
      </div>
    </section>

    <section class="section privacy" id="privacy">
      <p class="eyebrow">Privacy</p>
      <h2 class="reveal">Your meetings are <em>none of our business</em>.</h2>
      <div class="stats">
        <div class="reveal"><strong>0</strong><span>bytes of audio written to disk</span></div>
        <div class="reveal"><strong>0</strong><span>servers between you and your notes</span></div>
        <div class="reveal"><strong>0</strong><span>accounts, sign-ups or bots</span></div>
      </div>
      <p class="fine reveal">
        Oatmeal goes online for exactly two things: downloading the models, and checking GitHub for updates. You can
        turn the second one off. The source is on <a href={repo}>GitHub</a>, so you don't have to take our word for it.
      </p>
    </section>

    <section class="cta">
      <div class="glow" aria-hidden="true"></div>
      <img class="cta-icon" src={icon.src} width="112" height="112" alt="" />
      <h2>Your next meeting <em>takes its own notes</em>.</h2>
      <div class="actions">
        <a class="btn btn-honey" href={download}>Download Oatmeal</a>
        <a class="btn btn-ghost" href={repo}>View source</a>
      </div>
      <p class="platforms">Free and MIT licensed · macOS 15+ (Apple Silicon) · Linux x64</p>
    </section>

</Base>

<style>

  /* Hero */
  .hero {
    position: relative;
    text-align: center;
    padding: 96px 16px 0;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(255 255 255 / 4%);
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
  }
  .badge span:last-child {
    color: var(--honey);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--honey);
    box-shadow: 0 0 0 0 rgb(230 180 106 / 60%);
    animation: ping 2s infinite;
  }
  @keyframes ping {
    to {
      box-shadow: 0 0 0 10px rgb(230 180 106 / 0%);
    }
  }
  h1 {
    max-width: 14ch;
    margin: 28px auto 24px;
    font-size: clamp(3rem, 8.5vw, 6.5rem);
  }
  .lede {
    max-width: 36rem;
    margin: 0 auto;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 36px 0 16px;
  }
  .platforms {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }

  /* Product shot */
  .stage {
    position: relative;
    width: min(1100px, 100%);
    margin: 80px auto 0;
    perspective: 1800px;
  }
  .stage::before {
    content: '';
    position: absolute;
    inset: 10% 5% -5%;
    background: radial-gradient(closest-side, rgb(230 160 80 / 35%), transparent);
    filter: blur(60px);
    z-index: -1;
  }
  .window {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgb(255 235 205 / 14%);
    background: #1b1815;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 50%),
      0 50px 120px -30px rgb(0 0 0 / 80%);
    transform-origin: 50% 0;
  }
  .window-bar {
    display: flex;
    gap: 8px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }
  .window-bar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: rgb(255 235 205 / 14%);
  }
  .window img,
  .crop img,
  .fan img {
    display: block;
    width: 100%;
    height: auto;
  }
  .float {
    position: absolute;
    width: 34%;
    height: auto;
    border-radius: 14px;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 80%);
    animation: bob 6s ease-in-out infinite;
  }
  .float-left {
    left: -4%;
    bottom: 8%;
  }
  .float-right {
    right: -4%;
    bottom: -6%;
    animation-delay: -3s;
  }
  @keyframes bob {
    50% {
      transform: translateY(-12px);
    }
  }

  /* Marquee */
  .marquee {
    margin: 120px 0 0;
    text-align: center;
  }
  .marquee p {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .track {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
  }
  .track ul {
    display: flex;
    flex-shrink: 0;
    gap: 64px;
    margin: 0;
    padding: 0 32px;
    list-style: none;
    animation: scroll 30s linear infinite;
  }
  .track li {
    font: italic 2rem var(--serif);
    color: rgb(243 236 224 / 55%);
    white-space: nowrap;
  }
  @keyframes scroll {
    to {
      transform: translateX(-100%);
    }
  }

  /* Sections */
  .section {
    width: min(1100px, calc(100% - 32px));
    margin: 160px auto 0;
  }
  .section > h2,
  .cta h2 {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    max-width: 16ch;
  }

  /* Steps */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    padding: 28px;
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, rgb(255 235 205 / 4%), transparent 60%);
    border-radius: 4px;
  }
  .steps p {
    color: var(--muted);
    margin: 12px 0 0;
  }
  .step-num {
    display: block;
    margin-bottom: 40px;
    font: 0.85rem var(--mono);
    color: var(--honey);
  }
  .wave {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 40px;
    margin-top: 16px;
  }
  .wave span {
    flex: 1;
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(var(--honey), var(--honey-deep));
    animation: talk 1.2s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -97ms);
    transform: scaleY(0.15);
  }
  @keyframes talk {
    to {
      transform: scaleY(1);
    }
  }

  /* Bento */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    margin-top: 56px;
  }
  .card {
    position: relative;
    overflow: hidden;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background:
      radial-gradient(120% 80% at 0% 0%, rgb(230 180 106 / 7%), transparent 50%),
      var(--card);
    transition:
      border-color 0.3s,
      transform 0.3s;
  }
  .card:hover {
    border-color: rgb(230 180 106 / 30%);
  }
  .card > p,
  .card div > p {
    color: var(--muted);
    margin: 10px 0 0;
    max-width: 34rem;
  }
  .span-2 {
    grid-column: span 2;
  }
  .span-3 {
    grid-column: span 3;
  }
  .span-4 {
    grid-column: span 4;
    grid-row: span 2;
  }
  .span-6 {
    grid-column: span 6;
  }
  .crop {
    margin: 28px -28px -28px 28px;
    border-top-left-radius: 12px;
    border: 1px solid var(--line);
    border-right: 0;
    border-bottom: 0;
    overflow: hidden;
    mask-image: linear-gradient(#000 60%, transparent);
  }
  .mock-items {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
  }
  .mock-items li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    border-top: 1px solid var(--line);
  }
  .mock-items s {
    color: var(--muted);
  }
  .check {
    flex: none;
    width: 14px;
    height: 14px;
    border: 1px solid rgb(255 235 205 / 25%);
    border-radius: 4px;
  }
  .check.on {
    background: var(--honey);
    border-color: var(--honey);
  }
  .chip {
    margin-left: auto;
    padding: 1px 8px;
    border-radius: 999px;
    background: rgb(255 235 205 / 9%);
    font-weight: 500;
    font-size: 0.75rem;
  }
  .mock-items code {
    color: var(--muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
  }
  .chips li {
    padding: 4px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
  }
  .chips li.on {
    border-color: var(--honey);
    color: var(--honey);
    background: rgb(230 180 106 / 8%);
  }
  .mock-search {
    margin-top: 20px;
    font-size: 0.85rem;
  }
  .mock-input {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid rgb(230 180 106 / 40%);
    border-radius: 10px;
    box-shadow: 0 0 0 4px rgb(230 180 106 / 8%);
  }
  .mock-input svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .mock-search p {
    margin: 12px 0 0;
    color: var(--muted);
  }
  mark {
    background: rgb(230 180 106 / 25%);
    color: var(--text);
    border-radius: 3px;
    padding: 0 2px;
  }
  .files {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }
  .files span {
    display: grid;
    place-items: end start;
    width: 64px;
    height: 80px;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 6px 18px 6px 6px;
    background: linear-gradient(160deg, rgb(255 235 205 / 8%), transparent);
    font: 0.8rem var(--mono);
    color: var(--honey);
    transition: transform 0.3s;
  }
  .card:hover .files span:nth-child(1) {
    transform: rotate(-6deg) translateY(-4px);
  }
  .card:hover .files span:nth-child(3) {
    transform: rotate(6deg) translateY(-4px);
  }
  .themes-card {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    align-items: center;
    gap: 32px;
    min-height: 340px;
  }
  .fan {
    position: relative;
    height: 260px;
  }
  .fan img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 72%;
    border-radius: 10px;
    border: 1px solid rgb(255 255 255 / 12%);
    box-shadow: 0 20px 40px -10px rgb(0 0 0 / 70%);
    transform: translate(calc(-50% + (var(--i) - 1.5) * 12%), -50%) rotate(calc((var(--i) - 1.5) * 5deg));
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .themes-card:hover .fan img {
    transform: translate(calc(-50% + (var(--i) - 1.5) * 30%), -50%) rotate(calc((var(--i) - 1.5) * 7deg));
  }

  /* Privacy */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin: 56px 0 0;
  }
  .stats div {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 20px;
  }
  .stats strong {
    display: block;
    font: 400 7rem/1 var(--serif);
    background: linear-gradient(180deg, var(--text), rgb(243 236 224 / 20%));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stats span {
    color: var(--muted);
  }
  .fine {
    max-width: 44rem;
    margin: 32px 0 0;
    color: var(--muted);
  }

  /* CTA */
  .cta {
    position: relative;
    margin: 180px 0 0;
    padding: 120px 16px;
    text-align: center;
    overflow: hidden;
  }
  .cta .glow {
    inset: auto 0 -300px;
  }
  .cta h2 {
    margin: 32px auto 0;
  }
  .cta-icon {
    filter: drop-shadow(0 20px 50px rgb(230 160 80 / 50%));
  }

  /* Scroll-driven motion, where the browser has it. */
  @supports (animation-timeline: view()) {
    .window {
      animation: flatten linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 45%;
    }
    @keyframes flatten {
      from {
        transform: rotateX(24deg) scale(0.9);
        opacity: 0.6;
      }
    }
    .reveal {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 60%;
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(48px);
      }
    }
  }

  @media (max-width: 900px) {
    .bento {
      grid-template-columns: 1fr;
    }
    .span-2,
    .span-3,
    .span-4,
    .span-6 {
      grid-column: auto;
      grid-row: auto;
    }
    .themes-card {
      grid-template-columns: 1fr;
    }
    .fan {
      height: 200px;
    }
    .float {
      width: 44%;
    }
    .float-left {
      left: -2%;
      bottom: -14%;
    }
    .float-right {
      right: -2%;
      bottom: -22%;
    }
    .marquee {
      margin-top: 160px;
    }
    .stats strong {
      font-size: 5rem;
    }
  }

</style>
